# Перший спосіб — читання та виведення рядків по черзі
print("Reading line by line:")  # Виводимо підпис

with open("learning_python.txt", "r", encoding="utf-8") as file:  # Відкриваємо файл для читання
    for line in file:  # Перебираємо рядки файла
        print(line, end="")  # Виводимо рядок без додаткового переносу

# Другий спосіб — збереження рядків у списку
with open("learning_python.txt", "r", encoding="utf-8") as file:  # Відкриваємо файл повторно
    lines = file.readlines()  # Зчитуємо всі рядки у список

print("\nList of lines:")  # Виводимо підпис із нового рядка
print(lines)  # Виводимо список поза блоком with
