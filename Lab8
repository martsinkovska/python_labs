# Завдання 2.8. Пошук заголовків розділів Робінзона Крузо
# Очікуємо, що кожен заголовок займає один рядок і починається з CHAPTER

chapters = []  # Створюємо порожній список заголовків

with open("robinson.txt", "r", encoding="utf-8-sig") as file:  # Відкриваємо файл із текстом Робінзона Крузо
    for line in file:  # Перебираємо рядки книги
        line = line.strip()  # Прибираємо пробіли та переноси по краях рядка

        if line.startswith("CHAPTER ") and line not in chapters:  # Перевіряємо початок рядка та відсутність такого заголовка у списку
            chapters.append(line)  # Додаємо знайдений заголовок до списку

with open("chapters.txt", "w", encoding="utf-8") as file:  # Відкриваємо файл для збереження заголовків
    for chapter in chapters:  # Перебираємо всі знайдені заголовки
        file.write(chapter + "\n")  # Записуємо кожен заголовок з нового рядка


# Завдання 2.9. Відсоток малих і великих літер

lower = 0  # Лічильник малих літер
upper = 0  # Лічильник великих літер
letters = 0  # Лічильник усіх літер

with open("monte_cristo.txt", "r", encoding="utf-8-sig") as file:  # Відкриваємо текст Графа Монте-Крісто
    text = file.read()  # Зчитуємо весь текст

for char in text:  # По черзі беремо кожен символ тексту
    if char.isalpha():  # Перевіряємо, чи є символ літерою
        letters += 1  # Збільшуємо загальну кількість літер на одиницю

        if char.islower():  # Перевіряємо, чи літера мала
            lower += 1  # Збільшуємо кількість малих літер
        elif char.isupper():  # Якщо літера не мала, перевіряємо, чи вона велика
            upper += 1  # Збільшуємо кількість великих літер

if letters > 0:  # Перевіряємо наявність літер, щоб уникнути ділення на нуль
    print("Lowercase:", round(lower / letters * 100, 2), "%")  # Обчислюємо відсоток малих літер і округлюємо до двох знаків
    print("Uppercase:", round(upper / letters * 100, 2), "%")  # Обчислюємо відсоток великих літер і округлюємо до двох знаків
else:  # Виконуємо цей блок, якщо літер у тексті немає
    print("No letters found.")  # Повідомляємо, що літер не знайдено
