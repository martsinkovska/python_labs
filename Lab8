# Завдання 2.6. Підрахунок слова the у двох книгах

for filename in ["book1.txt", "book2.txt"]:  # По черзі беремо назви двох файлів книг
    with open(filename, "r", encoding="utf-8-sig") as file:  # Відкриваємо текст книги; utf-8-sig також прибирає початкову позначку BOM, якщо вона є
        text = file.read().lower()  # Зчитуємо весь текст і переводимо літери в нижній регістр

    words = re.findall(r"\bthe\b", text)  # Знаходимо всі окремі слова the; \b позначає межу слова, а r зберігає зворотні скісні риски
    print(filename, "- occurrences of 'the':", len(words))  # Виводимо назву файла та кількість знайдених слів


